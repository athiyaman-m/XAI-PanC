# ExAI-PanC v2 Environment Configuration

# Application
APP_NAME=ExAI-PanC Clinical Decision Support Platform
DEBUG=true

# Database (SQLite is used by default; override for production)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/exai_panc.db

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ML Models
MODELS_DIR=./models
UPLOAD_DIR=./backend/data/uploads

# Auth Provider
AUTH_PROVIDER=local
